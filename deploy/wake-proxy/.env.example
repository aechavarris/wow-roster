# Front-door (wake-proxy) config — copy to .env next to docker-compose.yml on the always-on host.
# Never commit the real file.

# Tailscale: a reusable, non-ephemeral auth key (https://login.tailscale.com/admin/settings/keys).
TS_AUTHKEY=
# Must be the same name the site is published under, so the public URL does not change.
TS_HOSTNAME=wow-roster

# The Steam Machine on the LAN (give it a static DHCP lease so this never changes):
BACKEND_HOST=            # e.g. 192.168.1.50
BACKEND_PORT=80          # Caddy on the Steam Machine
TARGET_MAC=              # wired MAC of the Steam Machine (deploy/wake/enable-wol.sh prints it)

# Usually fine as the limited broadcast; set to your subnet broadcast (e.g. 192.168.1.255) if needed.
WOL_BROADCAST=255.255.255.255
