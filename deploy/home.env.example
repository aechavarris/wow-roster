# Production .env for self-hosting on a home PC (copy to <HOME_DEPLOY_PATH>\.env).
# Never commit the real file.

# Caddy only serves plain HTTP inside the Tailscale container; Tailscale Funnel adds HTTPS.
DOMAIN=:80

# Tailscale (https://login.tailscale.com/admin/settings/keys): reusable auth key, not ephemeral.
TS_AUTHKEY=
TS_HOSTNAME=wow-roster
# Public URL = https://<TS_HOSTNAME>.<your tailnet>.ts.net (shown in the Tailscale admin console)
PUBLIC_URL=https://wow-roster.example.ts.net

# Blizzard: register ${PUBLIC_URL}/api/auth/callback as a redirect URL in the client.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
# Warcraft Logs API client (https://www.warcraftlogs.com/api/clients), client credentials flow.
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=
# Game version preselected for new rosters: forever | classic-era | anniversary | progression | retail
DEFAULT_GAME_VERSION=classic-era

# Use a long random password; it never leaves the Docker network.
POSTGRES_PASSWORD=

# Testing only: Forever has no public API yet, so its rosters can read real Classic Era characters
# (Blizzard API and Warcraft Logs) while keeping Forever's rules. Leave empty to disable.
# GAME_API_STAND_IN=forever=classic-era
GAME_API_STAND_IN=
