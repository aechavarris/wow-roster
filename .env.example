# Copy to .env and fill in. Never commit .env.

# --- Blizzard API (https://develop.battle.net/access/clients) ---
# Redirect URL to register in the Blizzard client: ${PUBLIC_URL}/api/auth/callback
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Default region for new guilds and logins: eu | us | kr | tw
BLIZZARD_REGION=eu

# --- Warcraft Logs API (https://www.warcraftlogs.com/api/clients) --- optional
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=

# --- Game versions ---
# Each roster picks its game version: forever (planned characters only until Blizzard
# publishes its API) | classic-era | anniversary (TBC) | progression (MoP Classic) | retail.
# This one is preselected in forms.
DEFAULT_GAME_VERSION=classic-era
# Optional extra version from a JSON file that may "extends" a built-in one
# GAME_PROFILE_PATH=/config/my-profile.json

# --- Production only (docker-compose.prod.yml) ---
# Domain Caddy serves with automatic HTTPS; PUBLIC_URL must then be https://${DOMAIN}
# DOMAIN=roster.example.com

# --- Local development only ---
# Lets you register any guild without an officer character (never enable in production)
# ALLOW_UNVERIFIED_GUILDS=true

# --- URLs ---
# Public URL users open in the browser (no trailing slash)
PUBLIC_URL=http://localhost:3000
# Where the web app reaches the API server-side
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000

# --- Infrastructure ---
POSTGRES_USER=wow
POSTGRES_PASSWORD=wow
POSTGRES_DB=wow_roster
DATABASE_URL=postgresql://wow:wow@localhost:5432/wow_roster
REDIS_URL=redis://localhost:6379

# --- Sync tuning ---
# Blizzard allows 36,000 requests/hour; each character sync uses ~7 requests.
SYNC_CHARACTER_JOBS_PER_SECOND=1
