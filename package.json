{
  "name": "wow-roster",
  "private": true,
  "description": "Roster manager for World of Warcraft: Forever guilds",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @wow/db generate",
    "db:migrate": "pnpm --filter @wow/db migrate:dev",
    "db:deploy": "pnpm --filter @wow/db migrate:deploy"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
