generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String            @id @default(cuid())
  bnetId      Int               @unique
  battletag   String
  locale      String            @default("es")
  createdAt   DateTime          @default(now())
  lastLoginAt DateTime?
  sessions    Session[]
  characters  Character[]
  memberships GuildMembership[]
  plannedEntries RosterEntry[]
}

/// The id is a SHA-256 hash of the session token stored in the cookie.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A roster in the app (shown as "roster" in the UI). kind "guild" mirrors an in-game guild
/// (realm/slug set, members synced from its roster); kind "custom" has no in-game guild and its
/// characters are added by officers or by the players themselves.
/// `realm` is the realm slug, or the ruleset key for realmless games.
model Guild {
  id                  String            @id @default(cuid())
  kind                String            @default("guild")
  /// Game version (config profile id) the roster belongs to: its rules and, for real characters, its API.
  gameVersion         String
  region              String
  realm               String?
  slug                String?
  name                String
  faction             String?
  blizzardId          Int?
  public              Boolean           @default(true)
  /// Listed for every signed-in user, who can propose characters; the owner accepts or rejects them.
  published           Boolean           @default(false)
  syncIntervalMinutes Int
  minLevel            Int
  /// Users owning a character at this in-game rank or lower (0 = guild master) are officers in the app.
  officerMaxRank      Int               @default(1)
  lastSyncedAt        DateTime?
  syncError           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  ranks               GuildRank[]
  memberships         GuildMembership[]
  roster              RosterEntry[]
  characters          Character[]
  invites             RosterInvite[]
  webhooks            RosterWebhook[]

  @@unique([gameVersion, region, realm, slug])
  @@index([published])
}

/// Link that grants a role in a roster. The id is a SHA-256 hash of the token in the URL.
model RosterInvite {
  id          String    @id
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  role        GuildRole
  createdById String
  expiresAt   DateTime
  maxUses     Int?
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([guildId])
}

/// Maps an in-game guild rank to a roster status key from the game profile.
model GuildRank {
  guildId String
  guild   Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  rank    Int
  label   String?
  status  String

  @@id([guildId, rank])
}

enum GuildRole {
  OWNER
  OFFICER
  MEMBER
}

model GuildMembership {
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId String
  guild   Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  role    GuildRole @default(MEMBER)

  @@id([userId, guildId])
}

/// A game character, shared by every app guild that tracks it.
model Character {
  id                 String          @id @default(cuid())
  /// Game version (config profile id) whose API the character is read from; names are unique per version.
  gameVersion        String
  region             String
  realm              String
  name               String
  /// Lowercased name used for lookups.
  nameKey            String
  blizzardId         Int?
  level              Int             @default(0)
  classId            Int?
  raceId             Int?
  gender             String?
  faction            String?
  specId             Int?
  specName           String?
  averageItemLevel   Float?
  equippedItemLevel  Float?
  lastLoginAt        DateTime?
  avatarUrl          String?
  /// In-game guild, when it is registered in the app.
  guildId            String?
  guild              Guild?          @relation(fields: [guildId], references: [id], onDelete: SetNull)
  guildRank          Int?
  /// Battle.net user that owns the character (verified at login).
  ownerId            String?
  owner              User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  isMain             Boolean         @default(false)
  /// Normalized details: equipment, talents, media, statistics, professions, reputations.
  profile            Json?
  /// Professions entered by the owner ([{ id, skill }]) for game versions whose API has none (Classic).
  manualProfessions  Json?
  /// Requirements (attunements) the owner ticked, as requirement keys of the game version's profile.
  manualRequirements Json?
  /// Best-in-slot wishlist the owner keeps ([{ slot, itemId, name, ... }]); see @wow/config bisListSchema.
  bis                Json?
  lastSyncedAt       DateTime?
  syncError          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  rosterEntries      RosterEntry[]
  weeks              CharacterWeek[]
  logReports         WarcraftLogsReportCharacter[]

  @@unique([gameVersion, region, realm, nameKey])
  @@index([guildId])
  @@index([ownerId])
}

/// A Discord webhook a roster posts character-progress announcements to. A roster can have several (different
/// servers or channels). `url` holds the webhook secret and is never returned in full by the API.
model RosterWebhook {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// Human label for the server/channel.
  label         String
  /// Discord webhook URL (contains a secret token); masked on read.
  url           String
  /// Progress event type keys this webhook announces (see @wow/config PROGRESS_EVENTS).
  events        String[]
  /// Language the announcements are written in.
  locale        String   @default("es")
  /// Announce every roster character; when false, only `characterIds`.
  allCharacters Boolean  @default(true)
  /// Character ids to announce when `allCharacters` is false.
  characterIds  String[]
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId])
}

/// A Warcraft Logs report seen while syncing a roster character, kept so a roster's Logs view is a growing
/// history instead of only the handful of recent reports the API returns. One row per report; the characters
/// seen in it accumulate in WarcraftLogsReportCharacter.
model WarcraftLogsReport {
  /// Warcraft Logs report code (the id in its URL).
  code       String                        @id
  /// Site the report lives on (vanilla.warcraftlogs.com…), for building its URL.
  host       String
  zoneId     Int?
  /// Localized zone name (profile raid name when it matches one, else the site's).
  zoneName   Json
  /// "raid" or "dungeon".
  type       String
  /// Earliest boss kill in the report, as the log's date.
  date       DateTime
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt
  characters WarcraftLogsReportCharacter[]

  @@index([date])
}

/// Links a Warcraft Logs report to a character seen in it; membership accumulates as rosters sync.
model WarcraftLogsReportCharacter {
  reportCode  String
  report      WarcraftLogsReport @relation(fields: [reportCode], references: [code], onDelete: Cascade)
  characterId String
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@id([reportCode, characterId])
  @@index([characterId])
}

/// Static game data (icons, talent trees) fetched once from the Blizzard API.
/// The key includes the game version and region, e.g. "retail:eu:icon:item:249961".
model StaticCache {
  key       String   @id
  /// JSON value; null records a lookup that had no data so it is not retried until it expires.
  data      Json?
  fetchedAt DateTime @default(now())
}

/// A character in an app guild's roster, with officer overrides.
model RosterEntry {
  id          String        @id @default(cuid())
  guildId     String
  guild       Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /// The game character; null for planned entries that do not exist in the game yet.
  characterId String?
  character   Character?    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// "guild" when it comes from the in-game roster, "manual" when added by hand, "planned" before it exists.
  source      String
  /// Planned entries: what the character will be. Linking a real character keeps these as history.
  plannedName    String?
  plannedClassId Int?
  plannedSpec    String?
  /// Second spec the player can switch to (dual spec), as a spec key of the entry's class; also off-spec for loot.
  offSpec        String?
  /// Who will play the entry: a free-text name and/or the app user (groups it with their characters).
  playerName     String?
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Best-in-slot wishlist for a planned entry (real entries keep theirs on the Character); see bisListSchema.
  bis         Json?
  /// Overrides the status derived from the guild rank.
  status      String?
  /// Overrides the role derived from the spec.
  role        String?
  note        String?
  /// Proposed by a signed-in non-member of a published roster; hidden from the roster until the owner accepts it.
  pending     Boolean       @default(false)
  /// Officer-defined main for characters without a verified owner.
  mainEntryId String?
  mainEntry   RosterEntry?  @relation("RosterAlts", fields: [mainEntryId], references: [id], onDelete: SetNull)
  alts        RosterEntry[] @relation("RosterAlts")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([guildId, characterId])
  @@index([guildId, pending])
}

/// What a character did in one game week (raid bosses, Mythic+ runs, dungeon bosses), rebuilt on each
/// sync during that week from the boss kill and run timestamps, and kept afterwards as weekly history.
model CharacterWeek {
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Start of the game week (the weekly reset of the character's region), UTC.
  weekStart   DateTime
  data        Json
  itemLevel   Float?
  updatedAt   DateTime  @updatedAt

  @@id([characterId, weekStart])
  @@index([weekStart])
}
